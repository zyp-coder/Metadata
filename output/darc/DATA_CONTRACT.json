{
  "_meta": {
    "title": "DATA_CONTRACT — 对外接口契约",
    "note": "回填打样草稿 v1（2026-07-25，第九十轮）——从存量代码提炼",
    "sources": ["frontend/src/api/modeling.ts", "frontend/src/api/archive.ts", "frontend/src/types/index.ts"],
    "conventions": {
      "baseURL": "/api",
      "pagination": "列表默认 DRF 分页 PaginatedResponse<T>{count,next,previous,results}；page/page_size 参数；管理类列表传 page_size=100000 拉全量",
      "error": "错误体 {error|detail|message}，DRF 字段校验错误 {field:[msg]}"
    }
  },
  "modules": {
    "modeling": [
      { "endpoint": "/data-sources/", "method": "GET|POST", "params": { "page": "number?", "body": "Partial<DataSource>" }, "response": "PaginatedResponse<DataSource> | DataSource" },
      { "endpoint": "/data-sources/{id}/", "method": "GET|PUT|DELETE", "params": { "body": "Partial<DataSource>" }, "response": "DataSource" },
      { "endpoint": "/data-sources/{id}/schemas/", "method": "GET", "params": { "include_counts": "'true'?" }, "response": "{schemas: string[], schema_table_counts?}" },
      { "endpoint": "/data-sources/{id}/external-tables/", "method": "GET", "params": { "schema": "string?", "has_data": "'true'?" }, "response": "{tables: {name,comment,row_count}[], schema}" },
      { "endpoint": "/data-sources/{id}/test-connection/", "method": "GET", "params": {}, "response": "{success, message?, error?}" },
      { "endpoint": "/data-sources/test-connection/", "method": "POST", "params": { "body": "Partial<DataSource>" }, "response": "{success, message?, error?}" },
      { "endpoint": "/domains/", "method": "GET|POST", "params": { "body": "Partial<Domain>" }, "response": "PaginatedResponse<Domain> | Domain" },
      { "endpoint": "/domains/{id}/", "method": "GET|PUT|DELETE", "params": { "body": "Partial<Domain>" }, "response": "Domain" },
      { "endpoint": "/domains/{id}/pk-status/", "method": "GET", "params": {}, "response": "{tables[], all_configured, total, configured_count}" },
      { "endpoint": "/tables/", "method": "GET|POST", "params": { "domain": "number?", "page_size": "100000(默认注入)" }, "response": "PaginatedResponse<Table> | Table" },
      { "endpoint": "/tables/{id}/", "method": "GET|PUT|DELETE", "params": { "body": "Partial<Table>" }, "response": "Table" },
      { "endpoint": "/tables/{id}/toggle-status/", "method": "PUT", "params": { "status": "'active'|'deprecated'" }, "response": "Table" },
      { "endpoint": "/tables/{id}/save-er-position/", "method": "PUT", "params": { "er_node_x": "number", "er_node_y": "number" }, "response": "{id, er_node_x, er_node_y}" },
      { "endpoint": "/tables/batch-reset-er-position/?domain={id}", "method": "POST", "params": {}, "response": "{reset_count}" },
      { "endpoint": "/tables/preview-excel/", "method": "POST(multipart)", "params": { "file": "File" }, "response": "{columns, rows, inferred_fields}" },
      { "endpoint": "/tables/import-excel/", "method": "POST(multipart)", "params": { "domain": "number", "configs": "json", "files": "File[]" }, "response": "{created[], errors[]}" },
      { "endpoint": "/tables/{id}/preview-data/", "method": "GET", "params": { "limit": "number?" }, "response": "{columns: string[], rows: any[][]}" },
      { "endpoint": "/tables/{id}/set-primary/", "method": "POST", "params": {}, "response": "{id, is_primary, message}" },
      { "endpoint": "/fields/", "method": "GET", "params": { "table": "number?", "domain": "number?" }, "response": "PaginatedResponse<Field>" },
      { "endpoint": "/fields/batch/?table={id}", "method": "POST", "params": { "fields": "{name,code?,sort_order?}[]" }, "response": "Field[]" },
      { "endpoint": "/fields/batch-attributes/", "method": "PUT", "params": { "fields": "Partial<Field>[]" }, "response": "Field[]" },
      { "endpoint": "/fields/{id}/deprecate/", "method": "PUT", "params": {}, "response": "Field" },
      { "endpoint": "/fields/ai-auto-group/?domain={id}", "method": "POST", "params": {}, "response": "-" },
      { "endpoint": "/fields/ai-semantic/?domain={id}", "method": "POST", "params": {}, "response": "Field[]" },
      { "endpoint": "/fields/detect-standards/?domain={id}", "method": "POST", "params": {}, "response": "{groups: StandardFieldSuggestion[]}" },
      { "endpoint": "/fields/apply-standards/?domain={id}", "method": "POST", "params": { "groups": "{standard_code,standard_name,field_ids}[]" }, "response": "StandardFieldModel[]" },
      { "endpoint": "/fields/standard-fields/?domain={id}", "method": "GET", "params": {}, "response": "StandardFieldAggregate[]" },
      { "endpoint": "/fields/refresh-distinct/?domain={id}", "method": "POST", "params": {}, "response": "{updated, errors[]}" },
      { "endpoint": "/fields/{id}/load-sample-values/", "method": "POST", "params": {}, "response": "{sample_values: any[]}" },
      { "endpoint": "/fields/manual-candidates/?domain={id}", "method": "GET", "params": {}, "response": "{candidates: ManualFieldCandidate[]}" },
      { "endpoint": "/fields/archive-preview/?domain={id}", "method": "GET", "params": {}, "response": "{schema: ArchiveSchemaItem[]}" },
      { "endpoint": "/fields/field-categories/?domain={id}", "method": "GET", "params": {}, "response": "FieldCategoryCounts" },
      { "endpoint": "/standard-fields/", "method": "GET|POST", "params": { "domain": "number?", "body": "Partial<StandardFieldModel> & {member_field_ids?}" }, "response": "PaginatedResponse<StandardFieldModel> | StandardFieldModel" },
      { "endpoint": "/standard-fields/{id}/", "method": "GET|PUT|PATCH|DELETE", "params": { "body": "Partial<StandardFieldModel>" }, "response": "StandardFieldModel" },
      { "endpoint": "/standard-fields/{id}/members-distinct/", "method": "GET", "params": {}, "response": "{members: StandardFieldMemberDistinct[]}" },
      { "endpoint": "/standard-fields/{id}/remove-member/", "method": "POST", "params": { "field_id": "number" }, "response": "{ok, removed_field_id, remaining}" },
      { "endpoint": "/standard-fields/{id}/add-member/", "method": "POST", "params": { "field_ids": "number[]" }, "response": "{ok, added_count, member_count}" },
      { "endpoint": "/standard-fields/{id}/set-primary-field/", "method": "POST", "params": { "field_id": "number|null" }, "response": "StandardFieldModel" },
      { "endpoint": "/computed-fields/", "method": "GET|POST", "params": { "domain": "number?", "body": "Partial<ComputedFieldModel>" }, "response": "PaginatedResponse<ComputedFieldModel> | ComputedFieldModel" },
      { "endpoint": "/computed-fields/{id}/", "method": "GET|PUT|PATCH|DELETE", "params": { "body": "Partial<ComputedFieldModel>" }, "response": "ComputedFieldModel" },
      { "endpoint": "/computed-fields/{id}/validate-formula/", "method": "POST", "params": { "expression": "string?" }, "response": "FormulaValidationResult" },
      { "endpoint": "/computed-fields/validate-expression/", "method": "POST", "params": { "expression": "string", "domain": "number" }, "response": "FormulaValidationResult" },
      { "endpoint": "/computed-fields/preview-data/", "method": "POST", "params": { "expression": "string", "domain": "number", "max_combinations": "number?" }, "response": "PreviewDataResult" },
      { "endpoint": "/computed-fields/generate-formula/", "method": "POST", "params": { "description": "string", "domain": "number", "selected_refs": "string[]?", "current_expression": "string?" }, "response": "GenerateFormulaResult" },
      { "endpoint": "/computed-fields/{id}/trial-calculate/", "method": "POST", "params": { "params": "Record<string,any[]>?", "auto_enumerate": "boolean?", "max_combinations": "number?" }, "response": "TrialCalculateResult" },
      { "endpoint": "/computed-fields/dependency-graph/", "method": "GET", "params": { "domain": "number" }, "response": "DependencyGraphResult" },
      { "endpoint": "/computed-fields/batch-recalculate/", "method": "POST", "params": { "domain": "number" }, "response": "BatchRecalculateResult" },
      { "endpoint": "/computed-fields/available-functions/", "method": "GET", "params": {}, "response": "{functions: AvailableFunction[]}" },
      { "endpoint": "/computed-fields/available-references/", "method": "GET", "params": { "domain": "number" }, "response": "{fields: AvailableReference[], computed_fields: AvailableReference[]}" },
      { "endpoint": "/computed-fields/plugins/", "method": "GET", "params": {}, "response": "{plugins: PluginInfo[]}" },
      { "endpoint": "/computed-fields/plugins/upload/", "method": "POST(multipart)", "params": { "file": "File" }, "response": "PluginInfo" },
      { "endpoint": "/computed-fields/plugins/unload/", "method": "POST", "params": { "filename": "string" }, "response": "{ok, filename}" },
      { "endpoint": "/computed-fields/plugins/reload/", "method": "POST", "params": { "filename": "string" }, "response": "PluginInfo" },
      { "endpoint": "/computed-fields/plugins/template/", "method": "GET", "params": {}, "response": "{template: string}" },
      { "endpoint": "/ai-config/current/", "method": "GET|PUT", "params": { "body": "Partial<AIConfigModel>" }, "response": "AIConfigModel" },
      { "endpoint": "/ai-config/test-connection/", "method": "POST", "params": { "body": "Partial<AIConfigModel>?" }, "response": "{ok, message}" },
      { "endpoint": "/field-groups/", "method": "GET|POST", "params": { "domain": "number?", "tree": "'1'?", "body": "Partial<FieldGroup>" }, "response": "PaginatedResponse<FieldGroup> | FieldGroup" },
      { "endpoint": "/field-groups/{id}/", "method": "PATCH|DELETE", "params": { "body": "Partial<FieldGroup>" }, "response": "FieldGroup" },
      { "endpoint": "/field-groups/reorder/", "method": "POST", "params": { "ordered_ids": "number[]" }, "response": "{updated}" },
      { "endpoint": "/field-options/", "method": "GET|POST", "params": { "field": "number?", "body": "Partial<FieldOption>" }, "response": "PaginatedResponse<FieldOption> | FieldOption" },
      { "endpoint": "/field-options/{id}/", "method": "DELETE", "params": {}, "response": "-" },
      { "endpoint": "/field-mappings/", "method": "GET|POST", "params": { "domain": "number?", "body": "Partial<FieldMapping>" }, "response": "PaginatedResponse<FieldMapping> | FieldMapping" },
      { "endpoint": "/field-mappings/{id}/", "method": "DELETE", "params": {}, "response": "-" }
    ],
    "archive": [
      { "endpoint": "/archives/", "method": "GET|POST", "params": { "page": "number?", "body": "Partial<Archive>" }, "response": "PaginatedResponse<Archive> | Archive" },
      { "endpoint": "/archives/{id}/", "method": "GET|PUT|DELETE", "params": { "body": "Partial<Archive>" }, "response": "Archive" },
      { "endpoint": "/archives/{id}/sync-schema/", "method": "POST", "params": { "operated_by": "string(默认 'system')" }, "response": "Archive(含 sync_stats)" },
      { "endpoint": "/archives/{id}/refresh-data/", "method": "POST", "params": { "operated_by": "string" }, "response": "Archive(含 sync_stats)" },
      { "endpoint": "/archives/{id}/refresh-preview/", "method": "GET", "params": {}, "response": "{schema_changes, data_changes}（前端按 any 使用，无强类型）" },
      { "endpoint": "/archives/{id}/consistency-check/", "method": "POST", "params": { "operated_by": "string" }, "response": "any（差异统计）" },
      { "endpoint": "/records/", "method": "GET|POST", "params": { "archive": "number?", "page": "number?", "body": "Partial<ArchiveRecord>" }, "response": "PaginatedResponse<ArchiveRecord> | ArchiveRecord" },
      { "endpoint": "/records/{id}/", "method": "GET|PUT|DELETE", "params": { "body": "Partial<ArchiveRecord>" }, "response": "ArchiveRecord" },
      { "endpoint": "/records/{id}/versions/", "method": "GET", "params": {}, "response": "PaginatedResponse<ArchiveVersion>" },
      { "endpoint": "/records/{id}/versions/compare/", "method": "GET", "params": { "v1": "number", "v2": "number" }, "response": "VersionCompare" },
      { "endpoint": "/records/{id}/rollback/", "method": "POST", "params": { "target_version": "number", "operated_by": "string" }, "response": "-" },
      { "endpoint": "/records/{id}/rollback-to-change/", "method": "POST", "params": { "target_detail_id": "number", "operated_by": "string" }, "response": "{rolled_back_fields, batch_id, new_version, changes?, message?}" },
      { "endpoint": "/records/{id}/pin/", "method": "POST", "params": { "operated_by": "string", "note": "string?" }, "response": "-" },
      { "endpoint": "/sync-logs/", "method": "GET", "params": { "archive": "number?" }, "response": "PaginatedResponse<SyncLog>" },
      { "endpoint": "/record-versions/", "method": "GET", "params": { "archive": "number?", "page": "number?" }, "response": "PaginatedResponse<GlobalVersion>" },
      { "endpoint": "/record-versions/{id}/pin/", "method": "POST", "params": { "operated_by": "string", "note": "string?" }, "response": "GlobalVersion" },
      { "endpoint": "/record-versions/{id}/unpin/", "method": "POST", "params": { "operated_by": "string" }, "response": "GlobalVersion" },
      { "endpoint": "/change-batches/", "method": "GET", "params": { "archive": "number?" }, "response": "PaginatedResponse<ChangeBatch>" },
      { "endpoint": "/change-details/", "method": "GET", "params": { "archive": "number?", "change_source": "string?", "change_type": "string?", "record_key": "string?", "page": "number?" }, "response": "PaginatedResponse<ChangeDetail>" },
      { "endpoint": "/change-details/export/", "method": "GET(blob)", "params": { "archive": "number" }, "response": "Blob(xlsx，双 Sheet)" },
      { "endpoint": "/change-details/{id}/rollback/", "method": "POST", "params": { "operated_by": "string" }, "response": "{rolled_back_fields, batch_id, new_version, changes?, message?}" },
      { "endpoint": "/domain-change-stats/", "method": "GET", "params": {}, "response": "DomainChangeStat[]（非分页，函数视图）" },
      { "endpoint": "/consistency-issues/", "method": "GET", "params": { "archive": "number?", "status": "string?" }, "response": "PaginatedResponse<ConsistencyIssue>" },
      { "endpoint": "/consistency-issues/batch-review/", "method": "POST", "params": { "ids": "number[]", "action": "'reviewed'|'ignored'|'reopen'", "note": "string?", "operated_by": "string?" }, "response": "{updated, skipped, action, batch_ids}" },
      { "endpoint": "/archive-apis/", "method": "GET|POST", "params": { "archive": "number?", "body": "Partial<ArchiveApi>" }, "response": "PaginatedResponse<ArchiveApi> | ArchiveApi" },
      { "endpoint": "/archive-apis/{id}/", "method": "GET|PUT|DELETE", "params": { "body": "Partial<ArchiveApi>" }, "response": "ArchiveApi" },
      { "endpoint": "/archive-apis/{id}/data/", "method": "GET", "params": {}, "response": "ArchiveApiData" },
      { "endpoint": "/archives/{id}/field-distinct-values/", "method": "GET", "params": {}, "response": "{ fields: FieldDistinctValue[], total_records: number }" }
    ]
  },
  "_type_locations": {
    "types/index.ts": ["DataSource", "Domain", "Table", "FieldGroup", "Field", "FieldOption", "FieldMapping", "Archive", "ArchiveApi", "ArchiveApiData", "ArchiveSchemaItem", "ArchiveRecord", "ArchiveVersion", "VersionCompare", "GlobalVersion", "SyncLog", "ChangeBatch", "ChangeDetail", "ConsistencyIssue", "PaginatedResponse"],
    "api/modeling.ts": ["StandardFieldModel", "StandardFieldAggregate", "StandardFieldSuggestion", "StandardFieldMember", "StandardFieldMemberDistinct", "ComputedFieldModel", "FormulaValidationResult", "TrialCalculateResult", "PreviewDataResult", "GenerateFormulaResult", "AvailableReference", "AIConfigModel", "FieldCategoryCounts", "ManualFieldCandidate", "ArchiveSchemaItem(重复定义)"],
    "api/archive.ts": ["DomainChangeStat", "FieldDistinctValue"]
  }
}
